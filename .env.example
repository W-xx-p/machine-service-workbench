# Application
APP_ENV=production
WEB_PORT=8080
APP_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
ACCESS_TOKEN_EXPIRE_MINUTES=480
ADMIN_USERNAME=admin
ADMIN_PASSWORD=REPLACE_WITH_A_STRONG_ADMIN_PASSWORD
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15
# Production defaults to no demo business data. Set true only for the showcase flow.
SEED_DEMO_DATA=false
UPLOAD_DIR=/app/data/uploads
MAX_UPLOAD_MB=30

# PostgreSQL + pgvector
POSTGRES_DB=machine_service
POSTGRES_USER=machine_service
POSTGRES_PASSWORD=REPLACE_WITH_A_URL_SAFE_DATABASE_PASSWORD

# Neo4j (read-only query templates are used by the application)
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=REPLACE_WITH_A_STRONG_NEO4J_PASSWORD
NEO4J_ENABLED=true

# Generic OpenAI-compatible placeholder. Disabled by default.
LLM_ENABLED=false
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
